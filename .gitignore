# dependencies and builds
node_modules/
dist/
dist-*/
.vite/
.wrangler/
*.tsbuildinfo

# raw downloads (re-fetched by tools/fetch-sources.mjs with checksums) and intermediate builds
sources/
build/

# harness, review and footage output (regenerated)
harness/out/
harness/LAST_RUN.md
review/inbox/
review/archive/
review/tour/
media/raw/

# secrets
.env
.env.*
!.env.example

# Claude Code local data (a plugin database lives in .claude/data)
.claude/data/
.claude/worktrees/
.claude/settings.local.json

# Python and tool environments
__pycache__/
*.pyc
tools/**/.venv/

# asset sources that are regenerated by scripts
assets-src/**/*.blend1
assets-src/**/raw/

# OS and editor
.DS_Store
Thumbs.db
*.log

# landing page build (tools/showcase/build-site.mjs)
site-dist/
